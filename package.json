{
	"name": "louisville-transit",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"build": "npm run build --workspace apps/alerts",
		"start": "node scripts/server.mjs",
		"dev": "PORT=3100 node scripts/server.mjs",
		"test:runtime": "node --test test/runtime.test.mjs",
		"test": "npm run test:runtime && npm test --workspace apps/insights && npm test --workspace apps/alerts -- --run"
	},
	"overrides": {
		"zod": "4.6.7"
	}
}
