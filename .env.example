# Public TARC feeds require no API key. Node 24 and FFmpeg are required.
PORT=3100
DATA_DIR=./state
POLL_INTERVAL_MS=60000
# Set to the public origin for absolute feeds, canonical URLs and social links.
PUBLIC_URL=http://localhost:3100

# Publishing stays off until dedicated accounts are configured and reviewed.
TRANSIT_PUBLISH_ENABLED=false
BLUESKY_SERVICE=https://bsky.social
BLUESKY_BUS_IDENTIFIER=
BLUESKY_BUS_APP_PASSWORD=
BLUESKY_BUS_DID=
BLUESKY_ALERTS_IDENTIFIER=
BLUESKY_ALERTS_APP_PASSWORD=
BLUESKY_ALERTS_DID=

# Optional street basemaps. Without a token, maps show labeled TARC geometry.
MAPBOX_TOKEN=
