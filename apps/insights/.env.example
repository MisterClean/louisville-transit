# TARC feeds are public; no agency API key required.
TRANSIT_DATA_DIR=./data/tarc
TRANSIT_STATE_DIR=./state
TRANSIT_WEB_DIR=./web
# Public publishing is explicitly opt-in and requires pinned account DIDs.
TRANSIT_PUBLISH_ENABLED=false
BLUESKY_SERVICE=https://bsky.social
BLUESKY_BUS_IDENTIFIER=
BLUESKY_BUS_APP_PASSWORD=
BLUESKY_BUS_DID=
BLUESKY_ALERTS_IDENTIFIER=
BLUESKY_ALERTS_APP_PASSWORD=
BLUESKY_ALERTS_DID=
# Optional map enrichment. Actual GTFS geometry renders without credentials.
PROTOMAPS_KEY=
# Runtime keeps next actionable stop prediction per trip, not full snapshots.
TARC_STORE_TRIP_UPDATE_STOPS=1
TARC_STORE_ALL_STOP_PREDICTIONS=false
TRANSIT_POSITION_RETENTION_DAYS=7
